{
  "name": "autoupdate-action",
  "version": "2.2.1",
  "description": "A GitHub Action that auto-updates PRs with changes from their base branch.",
  "main": "src/autoupdater.ts",
  "repository": "https://github.com/CSSUoB/pr-auto-updater",
  "author": "MattyTheHacker <<18513864+MattyTheHacker@users.noreply.github.com>>",
  "license": "MIT",
  "bin": "bin/cli.js",
  "scripts": {
    "build": "ncc build bin/cli.ts --out dist",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "9.1.1",
    "@octokit/types": "^17.0.0",
    "@octokit/webhooks": "^14.1.3",
    "@octokit/webhooks-types": "^7.6.1",
    "@types/node": "^26.2.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vercel/ncc": "^0.45.0",
    "babel-jest": "^30.4.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "jest-ts-auto-mock": "2",
    "nock": "15.0.0",
    "prettier": "^3.6.2",
    "ts-auto-mock": "3",
    "ts-node": "^10.9.2",
    "ttypescript": "^1.5.15",
    "typescript": "7.0.2"
  }
}
